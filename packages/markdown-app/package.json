{
  "name": "@vectojs/markdown-app",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Canvas-native Markdown reader and workbench for VectoJS.",
  "keywords": [
    "markdown",
    "editor",
    "canvas",
    "vectojs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/vectojs.git",
    "directory": "packages/markdown-app"
  },
  "bugs": {
    "url": "https://github.com/vectojs/vectojs/issues"
  },
  "homepage": "https://github.com/vectojs/vectojs#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "(cd ../core && bun run build) && (cd ../ui && bun run build) && (cd ../markdown && bun run build) && tsup src/index.ts --format cjs,esm --external @vectojs/core --external @vectojs/ui --external @vectojs/markdown --clean && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@vectojs/core": ">=1.38.0 <2.0.0",
    "@vectojs/markdown": ">=0.21.1 <1.0.0",
    "@vectojs/ui": ">=2.19.0 <3.0.0"
  },
  "devDependencies": {
    "@vectojs/core": "workspace:*",
    "@vectojs/markdown": "workspace:*",
    "@vectojs/ui": "workspace:*",
    "jsdom": "^30.0.1",
    "tsup": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
