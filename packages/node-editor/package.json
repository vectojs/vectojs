{
  "name": "@vectojs/node-editor",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Canvas-native node and link editor for VectoJS.",
  "keywords": [
    "node-editor",
    "graph",
    "canvas",
    "vectojs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/vectojs.git",
    "directory": "packages/node-editor"
  },
  "bugs": {
    "url": "https://github.com/vectojs/vectojs/issues"
  },
  "homepage": "https://github.com/vectojs/vectojs#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "(cd ../core && bun run build) && (cd ../ui && bun run build) && tsup src/index.ts --format cjs,esm --external @vectojs/core --external @vectojs/ui --clean && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@vectojs/core": ">=1.36.0 <2.0.0",
    "@vectojs/ui": ">=2.16.7 <3.0.0"
  },
  "devDependencies": {
    "@vectojs/core": "workspace:*",
    "@vectojs/ui": "workspace:*",
    "jsdom": "^30.0.1",
    "tsup": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
