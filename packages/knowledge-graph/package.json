{
  "name": "@vectojs/knowledge-graph",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "RDF-driven knowledge-graph domain layer on @vectojs/graph3d: adapter contract, typed entities, 2D/3D mode, onDemand a11y.",
  "keywords": [
    "knowledge-graph",
    "rdf",
    "graph",
    "vectojs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/vectojs.git",
    "directory": "packages/knowledge-graph"
  },
  "bugs": {
    "url": "https://github.com/vectojs/vectojs/issues"
  },
  "homepage": "https://github.com/vectojs/vectojs#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.mjs",
      "require": "./dist/model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "(cd ../graph3d && bun run build) && tsup src/index.ts src/model.ts --format cjs,esm --external @vectojs/graph3d --external three --external n3 --clean && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vectojs/graph3d": "workspace:*",
    "n3": "^2.13.12"
  },
  "peerDependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/n3": "^1.26.4",
    "@types/three": "^0.185.3",
    "jsdom": "^30.1.2",
    "three": "^0.186.1",
    "tsup": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
