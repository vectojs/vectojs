{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    // Three hygiene flags from the root config are relaxed here, and only here,
    // because of `src/kernel/` — KaTeX's parse and layout kernel, copied by
    // `scripts/vendor-katex.ts` from a pinned upstream commit and mechanically
    // stripped of MathML and DOM emission. That strip leaves behind unused
    // locals and imports, and a few functions whose MathML return path was
    // removed, which is 39 errors across 18 files: 32 TS6133 (unused local), 4
    // TS7030 (not all code paths return), 3 TS6196 (unused declaration).
    //
    // None are in code we wrote — `src/emit/`, `src/registry/`, `src/layout.ts`
    // and `src/glyphs/` are all clean, verified by running `tsc` with these
    // flags on and filtering out `src/kernel/`. Fixing them in place is not an
    // option that stays fixed: the next `bun run vendor` regenerates those files
    // from upstream and silently discards the edits, which is the same reasoning
    // `.oxlintrc.json` records for excluding `packages/tex/src/kernel/**` from
    // linting. This applies that existing, deliberate policy to the compiler.
    //
    // `tsc` emits declarations regardless (it defaults to
    // `noEmitOnError: false`), so the errors were never blocking the `.d.ts`
    // output — they were failing the `build` script's exit code, which is what
    // stopped `@vectojs/markdown` from consuming this package's types.
    //
    // The hygiene coverage is not simply lost: `oxlint` enforces unused locals
    // and unused parameters across every non-vendored file in the repo as a CI
    // gate. `noImplicitReturns` has no oxlint equivalent, so it is the one real
    // reduction — accepted because our code has zero violations today and the
    // vendored kernel can never be brought into compliance without forking it.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
