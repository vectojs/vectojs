# Dependencies
node_modules/

# Build output
dist/
build/
*.tgz

# Cache (Vite / Vitest / tsbuildinfo)
.vite/
.cache/
*.tsbuildinfo

# Test coverage
coverage/

# Benchmark output
scripts/.bench-results.json
scripts/.compare-results.json

# Rust / WASM core (crates/vectojs-core-rs)
# The .wasm asset is built by crates/vectojs-core-rs/build.sh in CI and
# published to npm — never committed. Contributors touching only TypeScript
# have no Rust toolchain, and the JS path is a permanent fallback.
crates/**/target/
packages/core/src/wasm/*.wasm
packages/graph3d/src/wasm/*.wasm

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local / env
*.local
.env
.env.*

# carryctx — share config but ignore local overrides + runtime state
.carryctx/config.local.toml
*.sqlite
# carryctx worktrees (created via `carryctx worktree create --path .worktrees/ctx-XXXX`)
.worktrees/
!.env.example

# Editor / OS
.DS_Store
Thumbs.db

# Git Worktree
.worktree/

# page/ are ignored, so a hand-written asset there still shows up.
benchmarks/*/results/
benchmarks/*/page/index.html
benchmarks/*/page/*.wasm
benchmarks/*/page/benchmark.js
benchmarks/*/page/benchmark.js.map
benchmarks/*/traces/
benchmarks/tmp/
tmp/
# Captured screenshots. Like results/, these are per-run artifacts of a specific
benchmarks/*/screenshots/
# markdown-showcase capture artifacts: diffs/ and evidence/ are per-run temp files,
# but baselines/ are committed as the regression gate.
benchmarks/markdown-showcase/diffs/
benchmarks/markdown-showcase/evidence/
